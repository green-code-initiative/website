{
  "name": "green-code-initiative.org",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite-ssg build",
    "lint": "eslint \"src/**/*.{js,ts,vue}\"",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@fontsource-variable/mulish": "^5.3.0",
    "@unhead/vue": "^2.1.17",
    "altcha": "^3.2.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@creedengo/eslint-plugin": "^3.1.0",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "prettier": "^3.9.6",
    "sass": "~1.103.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-ssg": "^28.3.0",
    "vite-ssg-sitemap": "^0.10.0",
    "vite-svg-loader": "^5.1.2",
    "vue-tsc": "^3.3.11"
  }
}
